## Example usage and walkthrough for webview
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Headless-safe showcase: every live section skips cleanly without a
## display or system web engine. Each slice opens its own window so the
## demo stays compilable in every feature selection.

import "../src/lib.alya" as pkg

function demo_backend()
    # 1. Backend selection (always available)
    say "--- 1. Backend ---"
    say "Backend id:   " + str(pkg::backend_id())
    say "Backend name: " + pkg::backend()
    say "Engine:       " + pkg::engine_version()
    say ""
end

@cfg(feature = "settings")
function demo_settings()
    # 2. Settings (pure, works everywhere)
    say "--- 2. Settings ---"
    let s = pkg::settings()
    say "Devtools: " + str(s.devtools) + ", JS: " + str(s.js)
    let custom = pkg::settings_with(0, 1, "AlyaDemo/1.0")
    say "Custom UA: " + custom.user_agent
    say "Apply to null (headless-safe): " + str(pkg::apply_settings(null, s))
    say ""
end

@cfg(not(feature = "settings"))
function demo_settings()
end

@cfg(feature = "events")
function demo_events()
    # 3. Event queue (pure, works everywhere)
    say "--- 3. Event Queue ---"
    let q = pkg::event_queue()
    say "Pending: " + str(pkg::drain(null, q))
    let ev = pkg::WebviewEvent { kind: 6, width: 0, height: 0, url: "about:blank", title: "", text: "hello" }
    say "Summary: " + ev.summary() + ", is_message=" + str(ev.is_message())
    say ""
end

@cfg(not(feature = "events"))
function demo_events()
end

@cfg(feature = "window")
function demo_window()
    # 4. Live window lifecycle (skipped headless)
    say "--- 4. Live Window ---"
    let w = pkg::open("Alya webview Demo", 800, 600)
    if w is null
        say "No display or engine on this machine — live demo skipped."
        say ""
        return
    end
    say "Window open: " + str(pkg::is_open(w)) + ", engine ready: " + str(pkg::is_ready(w))
    pkg::set_title(w, "Alya webview Demo")
    pkg::resize(w, 1024, 768)
    say "Resized to 1024x768."
    pkg::request_close(w)
    pkg::destroy(w)
    say "Closed cleanly."
    say ""
end

@cfg(not(feature = "window"))
function demo_window()
end

@cfg(feature = "navigation")
function demo_navigation()
    # 5. Navigation submits (skipped headless)
    say "--- 5. Navigation ---"
    let w = pkg::open("Alya webview Nav", 800, 600)
    if w is null
        say "No display or engine on this machine — navigation demo skipped."
        say ""
        return
    end
    say "load_html submitted: " + str(pkg::load_html(w, "<html><body><h1>Hello from Alya</h1></body></html>"))
    say "can_back: " + str(pkg::can_back(w))
    pkg::request_close(w)
    pkg::destroy(w)
    say ""
end

@cfg(not(feature = "navigation"))
function demo_navigation()
end

@cfg(feature = "scripting")
function demo_scripting()
    # 6. JavaScript eval (skipped headless)
    say "--- 6. Scripting ---"
    let w = pkg::open("Alya webview JS", 800, 600)
    if w is null
        say "No display or engine on this machine — scripting demo skipped."
        say ""
        return
    end
    if pkg::is_ready(w) == true
        let answer = pkg::eval_wait(w, "40+2", 800)
        say "JS 40+2 = " + answer
        say "post_message submitted: " + str(pkg::post_message(w, "{\"hello\":1}"))
    else
        say "Engine not attached — eval calls skipped."
    end
    pkg::request_close(w)
    pkg::destroy(w)
    say ""
end

@cfg(not(feature = "scripting"))
function demo_scripting()
end

@cfg(feature = "input")
function demo_input()
    # 7. Synthetic input (skipped headless)
    say "--- 7. Input ---"
    let w = pkg::open("Alya webview Input", 800, 600)
    if w is null
        say "No display or engine on this machine — input demo skipped."
        say ""
        return
    end
    pkg::mouse_move(w, 40, 40)
    pkg::mouse_click(w, 0)
    pkg::key_text(w, "hi")
    say "Synthetic input posted."
    pkg::request_close(w)
    pkg::destroy(w)
    say ""
end

@cfg(not(feature = "input"))
function demo_input()
end

@cfg(feature = "inspection")
function demo_inspection()
    # 8. Page inspection reads (skipped headless)
    say "--- 8. Inspection ---"
    let w = pkg::open("Alya webview Inspect", 800, 600)
    if w is null
        say "No display or engine on this machine — inspection demo skipped."
        say ""
        return
    end
    if pkg::is_ready(w) == true
        say "URL: " + pkg::current_url(w)
        say "Title: " + pkg::document_title(w)
    else
        say "Engine not attached — inspection calls skipped."
    end
    pkg::request_close(w)
    pkg::destroy(w)
    say ""
end

@cfg(not(feature = "inspection"))
function demo_inspection()
end

@cfg(feature = "storage_media")
function demo_storage()
    # 9. Storage and media submits (skipped headless)
    say "--- 9. Storage & Media ---"
    let w = pkg::open("Alya webview Media", 800, 600)
    if w is null
        say "No display or engine on this machine — storage demo skipped."
        say ""
        return
    end
    if pkg::is_ready(w) == true
        say "storage_set submitted: " + str(pkg::storage_set(w, "demo", "1"))
        say "scroll submitted: " + str(pkg::scroll_top(w))
        say "mute submitted: " + str(pkg::set_muted(w, 1))
    else
        say "Engine not attached — storage calls skipped."
    end
    pkg::request_close(w)
    pkg::destroy(w)
    say ""
end

@cfg(not(feature = "storage_media"))
function demo_storage()
end

function main()
    say "=== webview Package Showcase ==="
    say ""

    demo_backend()
    demo_settings()
    demo_events()
    demo_window()
    demo_navigation()
    demo_scripting()
    demo_input()
    demo_inspection()
    demo_storage()

    say "Done!"
end

main()
