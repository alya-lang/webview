## webview native tests: live window lifecycle + engine (when present)
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
##
## Real OS windows: skipped (passing) on headless runners or machines
## without a system web engine (no WebView2 Runtime / WebKitGTK).
## Each helper opens its own window so slices stay independently gated.

import "std/test"
import "../src/lib.alya" as pkg

@cfg(feature = "window")
function test_live_window(r)
    # 1. Open (null = headless or no engine, skip passing)
    let w = pkg::open("Alya CI Probe", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end
    runner_assert_eq(r, pkg::is_open(w), true, "window open")

    # 2. Show / hide flows
    runner_assert_eq(r, pkg::show(w), true, "show returns 1")
    runner_assert_eq(r, pkg::is_open(w), true, "still open")

    # 3. Resize + title are accepted on a live handle
    runner_assert_eq(r, pkg::resize(w, 400, 300), true, "resize requested")
    runner_assert_eq(r, pkg::set_title(w, "Alya Probe 2"), true, "set_title ok")
    runner_assert_eq(r, pkg::hide(w), true, "hide ok")
    runner_assert_eq(r, pkg::show(w), true, "show again ok")

    # 5. Private window lifecycle
    let p = pkg::open_private("Alya CI Private", 320, 200)
    if p is null
        runner_assert(r, 1 == 1, "no private window, skipped")
    else
        runner_assert_eq(r, pkg::is_open(p), true, "private open")
        runner_assert_eq(r, pkg::show(p), true, "private show")
        runner_assert_eq(r, pkg::request_close(p), true, "private close requested")
        pkg::destroy(p)
        runner_assert(r, 1 == 1, "private destroyed")
    end

    # 6b. Window visuals on the live window (no-crash + ranges)
    say "engine: " + pkg::engine_version()
    let bg = pkg::set_background(w, 0, 0, 0, 255)
    runner_assert_true(r, bg == 0 or bg == 1, "set_background in 0..1")
    let cm = pkg::set_context_menu(w, 0)
    runner_assert_true(r, cm == 0 or cm == 1, "set_context_menu in 0..1")
    runner_assert_true(r, pkg::set_context_menu(w, 1) == 0 or pkg::set_context_menu(w, 1) == 1, "context menu restore in 0..1")
    let sb = pkg::set_shortcut_block(w, 1)
    runner_assert_true(r, sb == 0 or sb == 1, "set_shortcut_block in 0..1")
    runner_assert_true(r, pkg::set_shortcut_block(w, 0) == 0 or pkg::set_shortcut_block(w, 0) == 1, "shortcut unblock in 0..1")
    let cs = pkg::set_charset(w, "UTF-8")
    runner_assert_true(r, cs == 0 or cs == 1, "set_charset in 0..1")

    # 7. Composition + control on the live window (tolerant ranges)
    let bl = pkg::set_borderless(w, 1)
    runner_assert_true(r, bl == 0 or bl == 1, "borderless in 0..1")
    runner_assert_true(r, pkg::set_borderless(w, 0) == 0 or pkg::set_borderless(w, 0) == 1, "border restore in 0..1")
    runner_assert_true(r, pkg::set_topmost(w, 1) == 0 or pkg::set_topmost(w, 1) == 1, "topmost in 0..1")
    runner_assert_true(r, pkg::set_topmost(w, 0) == 0 or pkg::set_topmost(w, 0) == 1, "topmost off in 0..1")
    runner_assert_true(r, pkg::set_opacity(w, 0.9) == 0 or pkg::set_opacity(w, 0.9) == 1, "opacity in 0..1")
    runner_assert_true(r, pkg::set_opacity(w, 1.0) == 0 or pkg::set_opacity(w, 1.0) == 1, "opacity restore in 0..1")
    runner_assert_true(r, pkg::set_opacity(w, 9.9) == 0, "opacity out of range is 0")
    runner_assert_true(r, pkg::set_click_through(w, 1) == 0 or pkg::set_click_through(w, 1) == 1, "click-through in 0..1")
    runner_assert_true(r, pkg::set_click_through(w, 0) == 0 or pkg::set_click_through(w, 0) == 1, "click restore in 0..1")
    runner_assert_true(r, pkg::set_fullscreen(w, 1) == 0 or pkg::set_fullscreen(w, 1) == 1, "fullscreen in 0..1")
    runner_assert_true(r, pkg::set_fullscreen(w, 0) == 0 or pkg::set_fullscreen(w, 0) == 1, "fullscreen off in 0..1")
    runner_assert_true(r, pkg::focus(w) == 0 or pkg::focus(w) == 1, "focus in 0..1")
    runner_assert_true(r, pkg::minimize(w) == 0 or pkg::minimize(w) == 1, "minimize in 0..1")
    runner_assert_true(r, pkg::restore(w) == 0 or pkg::restore(w) == 1, "restore in 0..1")
    runner_assert_true(r, pkg::maximize(w) == 0 or pkg::maximize(w) == 1, "maximize in 0..1")
    runner_assert_true(r, pkg::restore(w) == 0 or pkg::restore(w) == 1, "restore after maximize in 0..1")
    runner_assert_true(r, pkg::set_minimize_button(w, 0) == 0 or pkg::set_minimize_button(w, 0) == 1, "minimize button in 0..1")
    runner_assert_true(r, pkg::set_minimize_button(w, 1) == 0 or pkg::set_minimize_button(w, 1) == 1, "minimize button restore in 0..1")
    runner_assert_true(r, pkg::set_maximize_button(w, 0) == 0 or pkg::set_maximize_button(w, 0) == 1, "maximize button in 0..1")
    runner_assert_true(r, pkg::set_maximize_button(w, 1) == 0 or pkg::set_maximize_button(w, 1) == 1, "maximize button restore in 0..1")
    runner_assert_true(r, pkg::set_close_button(w, 0) == 0 or pkg::set_close_button(w, 0) == 1, "close button in 0..1")
    runner_assert_true(r, pkg::set_close_button(w, 1) == 0 or pkg::set_close_button(w, 1) == 1, "close button restore in 0..1")
    runner_assert_true(r, pkg::set_resizable(w, 0) == 0 or pkg::set_resizable(w, 0) == 1, "resizable off in 0..1")
    runner_assert_true(r, pkg::set_resizable(w, 1) == 0 or pkg::set_resizable(w, 1) == 1, "resizable on in 0..1")
    runner_assert_true(r, pkg::show(w) == 0 or pkg::show(w) == 1, "show after restore in 0..1")
    runner_assert_true(r, pkg::set_position(w, 100, 100) == 0 or pkg::set_position(w, 100, 100) == 1, "position in 0..1")

    # 10. Null safety on a dead handle path + graceful close
    runner_assert_eq(r, pkg::destroy(null), true, "destroy null safe")
    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "window"))
function test_live_window(r)
end

@cfg(feature = "events")
function test_live_events(r)
    let w = pkg::open("Alya CI Events", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    # Resize flows through a RESIZE event with the new size
    runner_assert_eq(r, pkg::resize(w, 400, 300), true, "resize requested")
    let rkind = 0
    let rticks = 0
    while rticks < 100
        rkind = pkg::poll(w)
        if rkind == 2
            break
        end
        rticks += 1
    end
    runner_assert_eq(r, rkind, 2, "RESIZE event pumped")

    # Drain maps native events to WebviewEvent records
    runner_assert_eq(r, pkg::resize(w, 420, 320), true, "resize 2 requested")
    let dq = pkg::event_queue()
    let dfound = false
    let dticks = 0
    while dticks < 200
        pkg::drain(w, dq)
        while pkg::event_queue_len(dq) > 0
            let dev = pkg::event_queue_poll(dq)
            if dev.kind == 2 and dev.width == 420 and dev.height == 320
                dfound = true
            end
        end
        if dfound == true
            break
        end
        dticks += 1
    end
    runner_assert_eq(r, dfound, true, "drain maps RESIZE with size")

    # Graceful close -> CLOSE event -> not open
    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    let kind = 0
    let ticks = 0
    while ticks < 100
        kind = pkg::poll(w)
        if kind == 1
            break
        end
        ticks += 1
    end
    runner_assert_eq(r, kind, 1, "CLOSE event pumped")
    runner_assert_eq(r, pkg::is_open(w), false, "closed after event")
    pkg::destroy(w)
end

@cfg(not(feature = "events"))
function test_live_events(r)
end

@cfg(feature = "navigation")
function test_live_navigation(r)
    let w = pkg::open("Alya CI Navigation", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    # Engine work only when the engine attached (ready == 1)
    if pkg::is_ready(w) == true
        runner_assert_eq(r, pkg::load_html(w, "<html><head><title>Probe</title></head><body>hi</body></html>"), true, "load_html accepted")
        # Out-of-process engines need wall-clock time: deadline-based wait.
        let nk = 0
        let start = clock_ms()
        while clock_ms() - start < 20000
            nk = pkg::poll(w)
            if nk == 4
                break
            end
            sleep(10)
        end
        runner_assert_eq(r, nk, 4, "NAV_DONE event pumped")
        runner_assert_true(r, pkg::stop(w) == 0 or pkg::stop(w) == 1, "stop in 0..1")
        runner_assert_true(r, pkg::reload_bypass(w) == 0 or pkg::reload_bypass(w) == 1, "reload_bypass in 0..1")

        # Failed navigation surfaces as NAV_FAILED (kind 7).
        runner_assert_eq(r, pkg::navigate(w, "http://invalid.invalid/"), true, "bad nav accepted")
        let fk = 0
        let f0 = clock_ms()
        while clock_ms() - f0 < 20000
            fk = pkg::poll(w)
            if fk == 7
                break
            end
            sleep(10)
        end
        runner_assert_eq(r, fk, 7, "NAV_FAILED event pumped")
        runner_assert_eq(r, pkg::can_back(w), false, "fresh page cannot go back")

        # Local folder serving (exact off-Windows, skipped on Windows)
        if pkg::backend() == "windows"
            runner_assert_eq(r, pkg::serve_folder("t", "."), false, "serve unsupported on windows")
            runner_assert_eq(r, pkg::clear_mapping("t"), true, "clear always processed")
        else
            if pkg::serve_folder("t", ".") == true
                runner_assert_eq(r, pkg::navigate(w, "alya://t/benches/bench_basic.alya"), true, "navigate app url accepted")
                let sk = 0
                let s0 = clock_ms()
                while clock_ms() - s0 < 20000
                    sk = pkg::poll(w)
                    if sk == 4
                        break
                    end
                    sleep(10)
                end
                runner_assert_eq(r, sk, 4, "app url NAV_DONE pumped")
                runner_assert_eq(r, pkg::clear_mapping("t"), true, "mapping cleared")
            else
                runner_assert(r, 1 == 1, "no serve support here, skipped")
            end
        end
    else
        runner_assert(r, 1 == 1, "no engine attached, browsing skipped")
        runner_assert_eq(r, pkg::navigate(w, "https://example.com"), false, "navigate without engine is 0")
    end

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "navigation"))
function test_live_navigation(r)
end

@cfg(feature = "scripting")
function test_live_scripting(r)
    let w = pkg::open("Alya CI Scripting", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    if pkg::is_ready(w) == true
        let js = pkg::eval_wait(w, "1+1", 800)
        runner_assert_str_eq(r, js, "2", "JS eval returns JSON result")

        # Diagnostics: install hooks, fire console + async error, collect.
        runner_assert_eq(r, pkg::on_error(w), true, "error hook submitted")
        runner_assert_eq(r, pkg::capture_console(w, 1), true, "console hook submitted")
        pkg::eval_wait(w, "1", 50)
        pkg::eval(w, "console.log('probe-console-1')")
        let gotc = false
        let c0 = clock_ms()
        while clock_ms() - c0 < 20000
            pkg::poll(w)
            let cm = pkg::fetch_message(w)
            if cm != "" and pkg::is_console(cm) == true
                gotc = true
            end
            if gotc == true
                break
            end
            sleep(10)
        end
        runner_assert_eq(r, gotc, true, "console entry forwarded")
        pkg::eval_wait(w, "1", 50)
        pkg::eval(w, "setTimeout(function(){throw new Error('probe-err-1')},0)")
        let gote = false
        let e0 = clock_ms()
        while clock_ms() - e0 < 20000
            pkg::poll(w)
            let em = pkg::fetch_message(w)
            if em != "" and pkg::is_js_error(em) == true
                gote = true
            end
            if gote == true
                break
            end
            sleep(10)
        end
        runner_assert_eq(r, gote, true, "js error forwarded")
        runner_assert_eq(r, pkg::capture_console(w, 0), true, "console hook removed")
        runner_assert_eq(r, pkg::post_message(w, "{\"ping\":1}"), true, "post_message delivered")
    else
        runner_assert(r, 1 == 1, "no engine attached, scripting skipped")
        runner_assert_eq(r, pkg::eval(w, "1"), false, "eval without engine is 0")
    end

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "scripting"))
function test_live_scripting(r)
end

@cfg(feature = "settings")
function test_live_settings(r)
    let w = pkg::open("Alya CI Settings", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    # Title + settings are accepted on a live handle
    let applied = pkg::apply_settings(w, pkg::settings())
    runner_assert_true(r, applied >= 0, "settings applied without error")

    let sz = pkg::set_zoom(w, 1.5)
    runner_assert_true(r, sz == 0 or sz == 1, "set_zoom in 0..1")
    runner_assert_true(r, pkg::get_zoom(w) >= 0.0, "get_zoom non-negative")
    let im = pkg::set_images(w, 1)
    runner_assert_true(r, im == 0 or im == 1, "set_images in 0..1")
    let gl = pkg::set_webgl(w, 1)
    runner_assert_true(r, gl == 0 or gl == 1, "set_webgl in 0..1")

    # Launch config roundtrip (uses the custom data dir)
    runner_assert_eq(r, pkg::set_data_dir(".alya/wvdata-test"), true, "data dir set")
    runner_assert_eq(r, pkg::set_extra_args("--disable-gpu"), true, "extra args set")
    runner_assert_str_eq(r, pkg::data_dir(), ".alya/wvdata-test", "data_dir roundtrips")
    runner_assert_str_eq(r, pkg::extra_args(), "--disable-gpu", "extra_args roundtrips")
    runner_assert_eq(r, pkg::set_data_dir(""), true, "data dir reset")
    runner_assert_eq(r, pkg::set_extra_args(""), true, "extra args cleared")

    # Profile path: Windows always backs windows with a folder;
    # macOS default/ephemeral stores have none.
    if pkg::backend() == "windows"
        runner_assert_true(r, len(pkg::profile_path(w)) > 0, "profile path set on windows")
    else
        runner_assert_true(r, pkg::profile_path(w) == "" or len(pkg::profile_path(w)) > 0, "profile path is a string")
    end

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "settings"))
function test_live_settings(r)
end

@cfg(feature = "input")
function test_live_input(r)
    let w = pkg::open("Alya CI Input", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    # Synthetic input + zoom on the live window (no-crash + ranges)
    let mm = pkg::mouse_move(w, 10, 10)
    runner_assert_true(r, mm == 0 or mm == 1, "mouse_move in 0..1")
    let mc = pkg::mouse_click(w, 0)
    runner_assert_true(r, mc == 0 or mc == 1, "mouse_click in 0..1")
    let mw = pkg::mouse_wheel(w, 0, 1)
    runner_assert_true(r, mw == 0 or mw == 1, "mouse_wheel in 0..1")
    let kt = pkg::key_tap(w, pkg::key_code("Enter"))
    runner_assert_true(r, kt == 0 or kt == 1, "key_tap in 0..1")
    let kx = pkg::key_text(w, "a")
    runner_assert_true(r, kx == 0 or kx == 1, "key_text in 0..1")

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "input"))
function test_live_input(r)
end

@cfg(feature = "inspection")
function test_live_inspection(r)
    let w = pkg::open("Alya CI Inspection", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    if pkg::is_ready(w) == true
        # Blank-page reads: every getter answers without crashing.
        runner_assert_true(r, len(pkg::get_source(w)) >= 0, "get_source is a string")
        runner_assert_true(r, len(pkg::get_text(w)) >= 0, "get_text is a string")
        runner_assert_true(r, len(pkg::document_title(w)) >= 0, "document_title is a string")
        runner_assert_true(r, len(pkg::current_url(w)) >= 0, "current_url is a string")
        runner_assert_true(r, len(pkg::history_length(w)) >= 0, "history_length is a string")
        runner_assert_true(r, len(pkg::user_agent(w)) >= 0, "user_agent is a string")
        runner_assert_true(r, len(pkg::viewport_width(w)) >= 0, "viewport_width is a string")
        runner_assert_true(r, len(pkg::viewport_height(w)) >= 0, "viewport_height is a string")
        runner_assert_true(r, len(pkg::doc_charset(w)) >= 0, "doc_charset is a string")
        runner_assert_true(r, len(pkg::page_language(w)) >= 0, "page_language is a string")
        runner_assert_true(r, len(pkg::referrer(w)) >= 0, "referrer is a string")
        let ol = pkg::is_online(w)
        runner_assert_true(r, ol == 0 or ol == 1, "is_online in 0..1")
        runner_assert_eq(r, pkg::find_text(w, "zzz-no-match"), false, "find_text misses cleanly")
    else
        runner_assert(r, 1 == 1, "no engine attached, inspection skipped")
    end

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "inspection"))
function test_live_inspection(r)
end

@cfg(feature = "storage_media")
function test_live_storage(r)
    let w = pkg::open("Alya CI Storage", 320, 200)
    if w is null
        runner_assert(r, 1 == 1, "no display/engine, skipped")
        return
    end

    if pkg::is_ready(w) == true
        runner_assert_eq(r, pkg::storage_set(w, "k1", "v1"), true, "storage_set submitted")
        # Note: blank pages live on an opaque origin where Web storage
        # throws, so no roundtrip is asserted here; submit coverage plus
        # the null-path suite exercise the wrappers.
        runner_assert_eq(r, pkg::storage_remove(w, "k1"), true, "storage_remove submitted")
        runner_assert_eq(r, pkg::scroll_to(w, 0, 0), true, "scroll_to submitted")
        runner_assert_eq(r, pkg::scroll_by(w, 0, 10), true, "scroll_by submitted")
        runner_assert_eq(r, pkg::scroll_top(w), true, "scroll_top submitted")
        runner_assert_eq(r, pkg::scroll_bottom(w), true, "scroll_bottom submitted")

        # Sound: submit-only on this media-free page, state read tolerant.
        runner_assert_eq(r, pkg::set_muted(w, 1), true, "set_muted submitted")
        let mu = pkg::is_muted(w)
        runner_assert_true(r, mu == 0 or mu == 1, "is_muted in 0..1")
        runner_assert_eq(r, pkg::set_volume(w, 50), true, "set_volume submitted")
        runner_assert_eq(r, pkg::set_volume(w, 999), true, "set_volume clamps high")
        runner_assert_eq(r, pkg::set_volume(w, -5), true, "set_volume clamps low")
        runner_assert_eq(r, pkg::set_muted(w, 0), true, "unmute submitted")
    else
        runner_assert(r, 1 == 1, "no engine attached, storage skipped")
    end

    runner_assert_eq(r, pkg::request_close(w), true, "close requested")
    pkg::destroy(w)
end

@cfg(not(feature = "storage_media"))
function test_live_storage(r)
end

function main()
    test_suite("webview Native Browser Tests")
    let r = runner_new()

    test_live_window(r)
    test_live_events(r)
    test_live_navigation(r)
    test_live_scripting(r)
    test_live_settings(r)
    test_live_input(r)
    test_live_inspection(r)
    test_live_storage(r)

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
