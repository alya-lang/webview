## webview Core Formatting Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Contains domain formatting logic, salutation builders, control flow,
## pattern matching, and string formatting routines.

import "../types.alya"

# ───────────────────────────────────────────────────────────────
# Private Formatting Helpers
# ───────────────────────────────────────────────────────────────

# Resolves a salutation prefix based on presentation style variant.
function build_salutation(prefix: string, style: int) -> string
    return when style
        is WebviewStyle.Formal => "Greetings and {prefix}"
        is WebviewStyle.Casual => "Hey"
        else                    => prefix
    end
end

# Resolves a human-readable label string for a given operational priority.
function build_priority_label(priority: int) -> string
    return when priority
        is WebviewPriority.Critical => "Critical"
        is WebviewPriority.High     => "High"
        is WebviewPriority.Normal   => "Normal"
        is WebviewPriority.Low      => "Low"
        else                         => "Normal"
    end
end

# ───────────────────────────────────────────────────────────────
# Public Formatting Functions
# ───────────────────────────────────────────────────────────────

## Formats a standard greeting message for the specified recipient name.
##
## ### Parameters
## - `name`: The recipient name string.
##
## ### Returns
## The formatted greeting string `"Hello, {name}!"`.
##
## ### Examples
## ```alya
## let msg = core_format_greeting("Alya") # "Hello, Alya!"
## ```
pub function core_format_greeting(name: string) -> string
    return "Hello, {name}!"
end

## Formats a personalized greeting message using configuration fields and style patterns.
##
## Evaluates the configuration's `style` enum variant via `when` pattern matching
## to determine the appropriate salutation prefix.
##
## ### Parameters
## - `config`: The `WebviewConfig` instance providing name, style, and priority.
##
## ### Returns
## The formatted greeting string `"{salutation}, {name}!"`.
##
## ### Examples
## ```alya
## let cfg = make_config("Alice", 1, WebviewPriority.Normal, WebviewStyle.Formal)
## let msg = core_format_custom(cfg) # "Greetings and Hello, Alice!"
## ```
pub function core_format_custom(config: WebviewConfig) -> string
    let salutation = build_salutation("Hello", config.style)
    return "{salutation}, {config.name}!"
end

## Builds a multi-field formatted summary string from a `WebviewConfig`.
##
## Summarizes name, count, priority label, and activation status.
##
## ### Parameters
## - `config`: The `WebviewConfig` instance to format.
##
## ### Returns
## A formatted single-line string describing all configuration fields.
##
## ### Examples
## ```alya
## let cfg = make_config("App", 2, WebviewPriority.High)
## say format_config(cfg)
## ```
pub function format_config(config: WebviewConfig) -> string
    let prio = build_priority_label(config.priority)
    let state_str = when config.enabled
        is 1 => "enabled"
        else => "disabled"
    end
    return "[Config] {config.name} (count: {config.count}, priority: {prio}, status: {state_str})"
end

## Formats a `WebviewResult` into an outcome string.
##
## ### Parameters
## - `result`: The `WebviewResult` instance to format.
##
## ### Returns
## A formatted string prefixed with `[OK]` or `[ERROR]`.
##
## ### Examples
## ```alya
## let r = ok_result("Done", "Completed")
## say format_result(r) # "[OK] Completed"
## ```
pub function format_result(result: WebviewResult) -> string
    if result.is_ok() == true
        return "[OK] {result.message}"
    end
    return "[ERROR] {result.message}"
end

## Formats a `WebviewStats` metric record into an overview string.
##
## ### Parameters
## - `stats`: The `WebviewStats` instance to format.
##
## ### Returns
## A formatted string showing total evaluated items and success percentage.
##
## ### Examples
## ```alya
## let s = make_stats(20, 18, 2, 0)
## say format_stats(s) # "[Stats] checked: 20, success rate: 90%"
## ```
pub function format_stats(stats: WebviewStats) -> string
    let checked = stats.total_checked()
    let rate = stats.success_rate()
    return "[Stats] checked: {checked}, success rate: {rate}"
end

## Formats an array of configuration records into an array of summary strings.
##
## ### Parameters
## - `configs`: Array of `WebviewConfig` instances.
##
## ### Returns
## Array of formatted summary strings.
##
## ### Examples
## ```alya
## let list = [make_config("Alpha"), make_config("Beta")]
## let summaries = format_batch(list)
## ```
pub function format_batch(configs: array) -> array
    let output = []
    for cfg in configs
        output.push(format_config(cfg))
    end
    return output
end

## Clamps an integer value to the closed interval `[min_val, max_val]`.
##
## ### Parameters
## - `n`: Target numeric value to clamp.
## - `min_val`: Lower bound.
## - `max_val`: Upper bound.
##
## ### Returns
## Clamped integer within `[min_val, max_val]`.
##
## ### Examples
## ```alya
## let c = clamp_count(150, 0, 100) # 100
## ```
pub function clamp_count(n: int, min_val: int, max_val: int) -> int
    if n < min_val
        return min_val
    elif n > max_val
        return max_val
    end
    return n
end

## Chooses the singular or plural form of a noun depending on count `n`.
##
## Demonstrates ternary pattern matching with `when`.
##
## ### Parameters
## - `n`: The item count.
## - `singular`: Word form for count of 1.
## - `plural`: Word form for counts other than 1.
##
## ### Returns
## `singular` if `n == 1`, otherwise `plural`.
##
## ### Examples
## ```alya
## say core_pluralize(1, "item", "items") # "item"
## say core_pluralize(3, "item", "items") # "items"
## ```
pub function core_pluralize(n: int, singular: string, plural: string) -> string
    return when n
        is 1 => singular
        else => plural
    end
end

## Builds an array repeating the given label `count` times.
##
## Demonstrates a `while` loop with accumulator push.
##
## ### Parameters
## - `label`: The string element to repeat.
## - `count`: Number of repetitions.
##
## ### Returns
## Array containing `count` copies of `label`.
##
## ### Examples
## ```alya
## let tags = repeat_label("default", 3) # ["default", "default", "default"]
## ```
pub function repeat_label(label: string, count: int) -> array
    let result = []
    let i = 0
    while i < count
        result.push(label)
        i += 1
    end
    return result
end
