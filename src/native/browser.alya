## Sets the default text encoding (`"UTF-8"`). Returns `1` when applied.
pub function native_browser_set_charset(win, cs: string) -> int
    if win is null
        return false
    end
    if cs is null or cs == ""
        cs = "UTF-8"
    end
    return alya_webview_set_charset(win, cs)
end

## Opens a browser window; null when no display or engine is available.
pub function native_browser_open(title: string, width: int, height: int)
    if title is null or title == ""
        title = "Alya"
    end
    if width <= 0
        width = 800
    end
    if height <= 0
        height = 600
    end
    return alya_webview_create(title, width, height)
end

## Destroys a browser window handle (null-safe).
pub function native_browser_close_handle(win) -> int
    alya_webview_destroy(win)
    return true
end

## Shows a browser window (null-safe).
pub function native_browser_show(win) -> int
    if win is null
        return false
    end
    alya_webview_show(win)
    return true
end

## Hides a browser window (null-safe).
pub function native_browser_hide(win) -> int
    if win is null
        return false
    end
    alya_webview_hide(win)
    return true
end

## Returns 1 while the window handle is open.
pub function native_browser_is_open(win) -> int
    if win is null
        return false
    end
    return alya_webview_is_open(win)
end

## Returns 1 when the rendering engine is attached (navigation works).
pub function native_browser_is_ready(win) -> int
    if win is null
        return false
    end
    return alya_webview_is_ready(win)
end

## Requests a graceful close (null-safe).
pub function native_browser_request_close(win) -> int
    if win is null
