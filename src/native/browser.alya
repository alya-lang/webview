## Commits printable text to the page. Returns `1` when posted.
pub function native_browser_key_text(win, text: string) -> int
    if win is null
        return false
    end
    if text is null or text == ""
        return false
    end
    return alya_webview_key_text(win, text)
end

## Maps a key name (`"Enter"`, `"Escape"`, `"Tab"`, `"Backspace"`,
## `"Delete"`, `"Left"`, `"Up"`, `"Right"`, `"Down"`, `"Home"`, `"End"`,
## `"PageUp"`, `"PageDown"`) to the platform code. `-1` when unknown.
pub function native_browser_key_code(name: string) -> int
    if name is null or name == ""
        return -1
    end
    return alya_webview_key_code(name)
end

