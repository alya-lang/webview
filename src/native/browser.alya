    end
    return alya_webview_set_context_menu(win, enabled)
end

## Toggles in-page shortcut blocking (Ctrl+P, PrintScreen, F12, ...).
## Returns `1` when applied.
pub function native_browser_set_shortcut_block(win, enabled: int) -> int
    if win is null
