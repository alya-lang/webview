## Presses a key (`code` is platform-native, see `native_browser_key_code`).
## Keys need keyboard focus on the page. Returns `1` when posted.
pub function native_browser_key_down(win, code: int) -> int
    if win is null
        return false
    end
    return alya_webview_key_down(win, code)
end

## Releases a key. Returns `1` when posted.
pub function native_browser_key_up(win, code: int) -> int
    if win is null
        return false
    end
    return alya_webview_key_up(win, code)
end

## Taps a key (press + release). Returns `1` when posted.
pub function native_browser_key_tap(win, code: int) -> int
    if win is null
        return false
