## webview/native/browser — native browser FFI (all backends)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Thin null-safe bindings over the per-OS C backends (`c/webview_win.c`,
## `c/webview_mac.c`, `c/webview_linux.c` share the `c/webview.h`
## contract). Window handles are opaque pointers; async browser work
## (navigation, JS eval, messages) arrives through `browser_drain` as
## `WebviewEvent` records, so no C-to-Alya callbacks are needed.

import "../types.alya"
import "../core/events.alya"
import "std/str" as str

# Strips one layer of JSON string quoting ("abc" -> abc).
# Non-strings (numbers, booleans, null) pass through untouched,
# except JSON null which maps to "" (unknown value).
function json_unquote(s: string) -> string
    if s is null or s == ""
        return ""
    end
    if s == "null"
        return ""
    end
    return str::trim_char(s, "\"")
end

