## Returns the embeddable engine version (`""` when not probeable).
pub function native_browser_engine_version() -> string
    let v = alya_webview_engine_version()
    if v is null
        return ""
    end
    return v
end

## Returns the compiled backend id (`1` Windows, `2` macOS, `3` Linux).
pub function native_backend_id() -> int
    return alya_webview_backend_id()
end

## Returns the compiled backend name (`"windows"`, `"macos"`, `"linux"`).
pub function native_backend_name() -> string
    let n = alya_webview_backend_name()
    if n is null
        return "unknown"
    end
    return n
end

## Opens a URL in the user's default browser (opt-in fallback for
## machines without an embeddable engine). Never blocks.
## Returns `1` when the launch was attempted.
pub function native_browser_open_external(url: string) -> int
    if url is null or url == ""
        return false
    end
    return alya_webview_open_external(url)
end

## Opens a private (incognito) window; no persistent profile is kept.
## Null when no display or engine is available.
pub function native_browser_open_private(title: string, width: int, height: int)
    if title is null or title == ""
        title = "Alya"
    end
    if width <= 0
        width = 800
    end
    if height <= 0
        height = 600
    end
    return alya_webview_create_private(title, width, height)
end

## Sets the profile data folder for subsequently opened windows
## (Windows/Linux; ignored on macOS). Empty string resets to default.
pub function native_browser_set_data_dir(path: string) -> int
    if path is null
        path = ""
    end
    alya_webview_set_data_dir(path)
    return true
end

## Sets extra Chromium switches for subsequently opened windows
## (Windows only; ignored elsewhere). Empty string clears them.
pub function native_browser_set_extra_args(args: string) -> int
    if args is null
        args = ""
    end
    alya_webview_set_extra_args(args)
    return true
end

## Sets the page zoom factor (`1.0` = 100%, range `0.25..5.0`).
## Returns `1` when applied (`0` where the backend cannot zoom).
pub function native_browser_set_zoom(win, factor: float) -> int
    if win is null
        return false
    end
    return alya_webview_set_zoom(win, factor as f64)
end

## Returns the current zoom factor (`0.0` when unknown).
pub function native_browser_get_zoom(win) -> float
    if win is null
        return 0.0
    end
    return alya_webview_get_zoom(win) as float
end

## Moves the synthetic cursor over client pixel (`x`, `y`).
## Returns `1` when posted.
pub function native_browser_mouse_move(win, x: int, y: int) -> int
    if win is null
        return false
    end
    return alya_webview_mouse_move(win, x, y)
end

