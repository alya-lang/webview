    return alya_webview_reload_bypass(win)
end

## Serves a local folder under `alya://host/path`. Returns `1` when
## registered (on macOS applies to subsequently opened windows).
pub function native_browser_serve_folder(host: string, folder: string) -> int
    if host is null or host == ""
        return false
    end
    if folder is null or folder == ""
        return false
    end
    return alya_webview_serve_folder(host, folder)
end

## Removes a folder mapping (`""` clears all). Returns `1` when processed.
pub function native_browser_clear_mapping(host: string) -> int
    if host is null
        host = ""
    end
    return alya_webview_clear_mapping(host)
end

# ───────────────────────────────────────────────────────────────
# Page helpers (pure scripting over eval; uniform on all engines)
# ───────────────────────────────────────────────────────────────
# Notes: string arguments must not contain single quotes (v1
# limitation); eval results are JSON-encoded (strings arrive quoted).

## Finds text in the page (`window.find`); returns `1` when found.
pub function native_browser_find_text(win, query: string) -> int
    if win is null
        return false
    end
    if query is null or query == ""
        return false
    end
    if native_browser_eval_wait(win, "window.find('" + query + "')", 200) == "true"
        return true
    end
    return false
end

## Returns the page HTML source (`""` when unavailable).
pub function native_browser_get_source(win) -> string
    if win is null
        return ""
    end
    return native_browser_eval_wait(win, "document.documentElement.outerHTML", 200)
end

## Returns the rendered page text (`""` when unavailable).
pub function native_browser_get_text(win) -> string
    if win is null
        return ""
    end
    return native_browser_eval_wait(win, "document.body.innerText", 200)
end

## Returns the document title (`""` when unavailable).
pub function native_browser_document_title(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "document.title", 200))
end

## Returns the current URL (`""` when unavailable).
pub function native_browser_current_url(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "location.href", 200))
end

## Returns the history length (`""` when unavailable).
pub function native_browser_history_length(win) -> string
    if win is null
        return ""
    end
    return native_browser_eval_wait(win, "history.length", 200)
end

## Returns the navigator user-agent (`""` when unavailable).
pub function native_browser_user_agent(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "navigator.userAgent", 200))
end

## Returns the viewport width in CSS pixels (`""` when unavailable).
pub function native_browser_viewport_width(win) -> string
    if win is null
        return ""
    end
    return native_browser_eval_wait(win, "window.innerWidth", 200)
end

## Returns the viewport height in CSS pixels (`""` when unavailable).
pub function native_browser_viewport_height(win) -> string
    if win is null
        return ""
    end
    return native_browser_eval_wait(win, "window.innerHeight", 200)
end

## Returns the document character set (`""` when unavailable).
pub function native_browser_doc_charset(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "document.characterSet", 200))
end

## Returns the page language (`""` when unavailable).
pub function native_browser_page_language(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "navigator.language", 200))
end

## Returns `1` when the page reports itself online.
pub function native_browser_is_online(win) -> int
    if win is null
        return false
    end
    if native_browser_eval_wait(win, "navigator.onLine", 200) == "true"
        return true
    end
    return false
end

## Returns the referrer (`""` when none).
pub function native_browser_referrer(win) -> string
    if win is null
        return ""
    end
    return json_unquote(native_browser_eval_wait(win, "document.referrer", 200))
end

## Reads a localStorage value (JSON-encoded, `""` when missing).
pub function native_browser_storage_get(win, key: string) -> string
    if win is null
        return ""
    end
    if key is null or key == ""
        return ""
    end
    return native_browser_eval_wait(win, "localStorage.getItem('" + key + "')", 200)
end

## Writes a localStorage value; returns `1` when submitted.
pub function native_browser_storage_set(win, key: string, value: string) -> int
    if win is null
        return false
    end
    if key is null or key == ""
        return false
    end
    if value is null
        value = ""
    end
    return native_browser_eval(win, "localStorage.setItem('" + key + "','" + value + "')")
end

## Removes a localStorage value; returns `1` when submitted.
pub function native_browser_storage_remove(win, key: string) -> int
    if win is null
        return false
    end
    if key is null or key == ""
        return false
    end
    return native_browser_eval(win, "localStorage.removeItem('" + key + "')")
end

## Scrolls to document pixel (`x`, `y`); returns `1` when submitted.
pub function native_browser_scroll_to(win, x: int, y: int) -> int
    if win is null
        return false
    end
    return native_browser_eval(win, "window.scrollTo(" + str(x) + "," + str(y) + ")")
end

## Scrolls by (`dx`, `dy`) pixels; returns `1` when submitted.
pub function native_browser_scroll_by(win, dx: int, dy: int) -> int
    if win is null
        return false
    end
    return native_browser_eval(win, "window.scrollBy(" + str(dx) + "," + str(dy) + ")")
end

## Scrolls to the top; returns `1` when submitted.
pub function native_browser_scroll_top(win) -> int
    if win is null
        return false
    end
    return native_browser_eval(win, "window.scrollTo(0,0)")
end

## Scrolls to the bottom; returns `1` when submitted.
pub function native_browser_scroll_bottom(win) -> int
    if win is null
        return false
    end
    return native_browser_eval(win, "window.scrollTo(0,document.body.scrollHeight)")
end

## Opens the print dialog; returns `1` when submitted.
pub function native_browser_print_page(win) -> int
    if win is null
        return false
    end
    return native_browser_eval(win, "window.print()")
end

## Returns the configured profile folder (`""` when default).
pub function native_browser_data_dir() -> string
    let d = alya_webview_get_data_dir()
    if d is null
        return ""
    end
    return d
end

## Returns the configured extra switches (`""` when none).
pub function native_browser_extra_args() -> string
    let a = alya_webview_get_extra_args()
    if a is null
        return ""
    end
    return a
end

## Returns the actual folder backing an open window (`""` when none).
pub function native_browser_profile_path(win) -> string
    if win is null
        return ""
    end
    let p = alya_webview_profile_path(win)
    if p is null
        return ""
    end
    return p
end

## Opens a browser window; null when no display or engine is available.
pub function native_browser_open(title: string, width: int, height: int)
    if title is null or title == ""
        title = "Alya"
    end
    if width <= 0
        width = 800
    end
    if height <= 0
        height = 600
    end
    return alya_webview_create(title, width, height)
end

## Destroys a browser window handle (null-safe).
pub function native_browser_close_handle(win) -> int
    alya_webview_destroy(win)
    return true
end

## Shows a browser window (null-safe).
pub function native_browser_show(win) -> int
    if win is null
        return false
    end
    alya_webview_show(win)
    return true
end

## Hides a browser window (null-safe).
pub function native_browser_hide(win) -> int
    if win is null
        return false
    end
    alya_webview_hide(win)
    return true
end

## Returns 1 while the window handle is open.
pub function native_browser_is_open(win) -> int
    if win is null
        return false
    end
    return alya_webview_is_open(win)
end

## Returns 1 when the rendering engine is attached (navigation works).
pub function native_browser_is_ready(win) -> int
    if win is null
        return false
    end
    return alya_webview_is_ready(win)
end

## Requests a graceful close (null-safe).
pub function native_browser_request_close(win) -> int
    if win is null
        return false
    end
    alya_webview_request_close(win)
    return true
end

## Sets the window title (null-safe).
pub function native_browser_set_title(win, title: string) -> int
    if win is null
        return false
    end
    if title is null
        title = ""
    end
    alya_webview_set_title(win, title)
    return true
end

## Resizes the window client area (null-safe).
pub function native_browser_resize(win, width: int, height: int) -> int
    if win is null
        return false
    end
    alya_webview_set_size(win, width, height)
    return true
end

## Navigates to a URL; returns `1` when accepted.
pub function native_browser_navigate(win, url: string) -> int
    if win is null
        return false
    end
    if url is null or url == ""
        return false
    end
    return alya_webview_navigate(win, url)
end

## Loads an HTML document string; returns `1` when accepted.
pub function native_browser_load_html(win, html: string) -> int
    if win is null
        return false
    end
    if html is null
        html = ""
    end
    return alya_webview_load_html(win, html)
end

## Reloads the current page; returns `1` when accepted.
pub function native_browser_reload(win) -> int
    if win is null
        return false
    end
    return alya_webview_reload(win)
end

## Goes back in history; returns `1` when accepted.
pub function native_browser_back(win) -> int
    if win is null
        return false
    end
    return alya_webview_go_back(win)
end

## Goes forward in history; returns `1` when accepted.
pub function native_browser_forward(win) -> int
    if win is null
        return false
    end
    return alya_webview_go_forward(win)
end

## Returns 1 when back navigation is possible.
pub function native_browser_can_back(win) -> int
    if win is null
        return false
    end
    return alya_webview_can_back(win)
end

## Returns 1 when forward navigation is possible.
pub function native_browser_can_forward(win) -> int
    if win is null
        return false
    end
    return alya_webview_can_forward(win)
end

## Runs JS asynchronously; the JSON-encoded result is polled via
## `native_browser_eval_state` / `native_browser_eval_result`.
## Returns `1` when the script was submitted.
pub function native_browser_eval(win, js: string) -> int
    if win is null
        return false
    end
    if js is null or js == ""
        return false
    end
    return alya_webview_eval(win, js)
end

## Returns the pending eval state (`0` pending, `1` ready, `2` error).
pub function native_browser_eval_state(win) -> int
    if win is null
        return WebviewEvalState.Error
    end
    return alya_webview_eval_state(win)
end

## Returns the last JS eval result (`""` when none).
pub function native_browser_eval_result(win) -> string
    if win is null
        return ""
    end
    let r = alya_webview_eval_result(win)
    if r is null
        return ""
    end
    return r
end

## Delivers a string to the page through `window.postMessage`
## (observed with `window.addEventListener("message")`).
## Returns `1` when delivered.
pub function native_browser_post_message(win, json: string) -> int
    if win is null
        return false
    end
    if json is null
        json = "null"
    end
    return alya_webview_post_message(win, json)
end

## Toggles developer tools; returns `1` when applied.
pub function native_browser_set_devtools(win, enabled: int) -> int
    if win is null
        return false
    end
    return alya_webview_set_devtools(win, enabled)
end

## Toggles JavaScript; returns `1` when applied.
pub function native_browser_set_js(win, enabled: int) -> int
    if win is null
        return false
    end
    return alya_webview_set_js(win, enabled)
end

## Overrides the user-agent string; returns `1` when applied.
pub function native_browser_set_user_agent(win, ua: string) -> int
    if win is null
        return false
    end
    if ua is null
        ua = ""
    end
    return alya_webview_set_user_agent(win, ua)
end

## Applies a `WebviewSettings` record; returns applied count.
pub function native_browser_apply_settings(win, s: WebviewSettings) -> int
    if win is null or s is null
        return 0
    end
    let n = 0
    n += native_browser_set_devtools(win, s.devtools)
    n += native_browser_set_js(win, s.js)
    if s.user_agent != ""
        n += native_browser_set_user_agent(win, s.user_agent)
    end
    return n
end

## Pumps once; returns the event kind (`0` = none, else `WebviewEventKind`).
pub function native_browser_poll(win) -> int
    if win is null
        return WebviewEventKind.None
    end
    return alya_webview_poll(win)
end

## Last event: current URL (`""` when unknown).
pub function native_browser_last_url(win) -> string
    if win is null
        return ""
    end
    let u = alya_webview_event_url(win)
    if u is null
        return ""
    end
    return u
end

## Last event: document title (`""` when unknown).
pub function native_browser_last_title(win) -> string
    if win is null
        return ""
    end
    let t = alya_webview_event_title(win)
    if t is null
        return ""
    end
    return t
end

## Last `Message` event: payload text (`""` when none).
pub function native_browser_last_text(win) -> string
    if win is null
        return ""
    end
    let t = alya_webview_event_text(win)
    if t is null
        return ""
    end
    return t
end

## Drains all pending native events into `q` as `WebviewEvent` records.
## Returns the event count drained (`0` for null handles/queues).
pub function native_browser_drain(win, q: WebviewEventQueue) -> int
    if win is null or q is null
        return 0
    end
    let n = 0
    while n < 64
        let kind = alya_webview_poll(win)
        if kind == WebviewEventKind.None
            break
        end
        let ev = WebviewEvent {
            kind: kind,
            width: alya_webview_event_width(win),
            height: alya_webview_event_height(win),
            url: native_browser_last_url(win),
            title: native_browser_last_title(win),
            text: native_browser_last_text(win)
        }
        event_queue_push(q, ev)
        n += 1
    end
    return n
end

## Submits JS and waits up to `budget` pumps for the result.
## Each pump yields ~10ms so out-of-process engines can answer.
## Returns the JSON-encoded result, or `""` on error/timeout.
pub function native_browser_eval_wait(win, js: string, budget: int = 200) -> string
    if win is null
        return ""
    end
    if js is null or js == ""
        return ""
    end
    if budget <= 0
        budget = 200
    end
    if native_browser_eval(win, js) == 0
        return ""
    end
    let i = 0
    while i < budget
        native_browser_poll(win)
        if native_browser_eval_state(win) == WebviewEvalState.Ready
            return native_browser_eval_result(win)
        end
        if native_browser_eval_state(win) == WebviewEvalState.Error
            return ""
        end
        sleep(10)
        i += 1
    end
    return ""
end
