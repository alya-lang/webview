## webview Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point and facade for the webview package,
## exposing models, enums, constructors, interfaces, and processing workflows.

import "./types.alya"
import "./core/formatter.alya"
@cfg(feature = "extras")
import "./core/extras.alya"

# ───────────────────────────────────────────────────────────────
# Primary Facade APIs
# ───────────────────────────────────────────────────────────────

## Formats and returns a greeting message for the specified recipient.
##
## Defaults to `"World"` if the name parameter is omitted, empty, or null.
##
## ### Parameters
## - `name`: The name of the recipient to greet. Defaults to `"World"`.
##
## ### Returns
## A formatted greeting string, e.g. `"Hello, World!"`.
##
## ### Examples
## ```alya
## let msg = hello("Alya")
## say msg # "Hello, Alya!"
## ```
pub function hello(name = "World") -> string
    let clean = sanitize_name(name)
    return core_format_greeting(clean)
end

## Constructs a new configuration model instance with specified or default values.
##
## ### Parameters
## - `name`: Target recipient or entity name. Defaults to `"World"`.
## - `count`: Number of iterations or repetition limit. Defaults to `1`.
## - `priority`: Operational priority level (`WebviewPriority`). Defaults to `WebviewPriority.Normal`.
## - `style`: Formality style variant code (`WebviewStyle`). Defaults to `WebviewStyle.Standard`.
##
## ### Returns
## A newly initialized `WebviewConfig` instance.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 5, WebviewPriority.High, WebviewStyle.Formal)
## ```
pub function new_config(name = "World", count: int = 1, priority: int = WebviewPriority.Normal, style: int = WebviewStyle.Standard) -> WebviewConfig
    return make_config(name, count, priority, style)
end

## Processes a configuration label through the formatting pipeline, returning a `WebviewResult`.
##
## ### Parameters
## - `label`: The target entity label string. Defaults to `"World"`.
## - `count`: Counter or repetition count. Defaults to `1`.
## - `priority`: Priority tier. Defaults to `WebviewPriority.Normal`.
##
## ### Returns
## A successful `WebviewResult` containing the formatted summary string.
##
## ### Examples
## ```alya
## let res = process("Alice", 3, WebviewPriority.High)
## say res.message # "OK"
## ```
pub function process(label = "World", count: int = 1, priority: int = WebviewPriority.Normal) -> WebviewResult
    let cfg = make_config(label, count, priority)
    let formatted = format_config(cfg)
    return ok_result(formatted, "OK")
end

## Processes an array of labels in batch, returning an array of formatted strings.
##
## Handles null input safely by returning an empty array.
##
## ### Parameters
## - `labels`: Array of label strings to process (or null).
##
## ### Returns
## An array of formatted result strings.
##
## ### Examples
## ```alya
## let results = process_batch(["Alpha", "Beta"])
## ```
pub function process_batch(labels) -> array
    if labels is null
        return []
    end

    let configs = []
    for lbl in labels
        configs.push(make_config(lbl, 1, WebviewPriority.Normal))
    end
    return format_batch(configs)
end

## Formats and returns the summary representation of a configuration.
##
## Demonstrates struct method dispatch and interface satisfaction (`Summarizable`).
##
## ### Parameters
## - `cfg`: A `WebviewConfig` instance.
##
## ### Returns
## The string returned by the config's `summary()` method.
##
## ### Examples
## ```alya
## let cfg = new_config("Community", 3)
## say format_summary(cfg)
## ```
pub function format_summary(cfg: WebviewConfig) -> string
    return cfg.summary()
end

## Formats and returns the description of a configuration.
##
## Demonstrates struct method dispatch and interface satisfaction (`Describable`).
##
## ### Parameters
## - `cfg`: A `WebviewConfig` instance.
##
## ### Returns
## The string returned by `describe()`.
##
## ### Examples
## ```alya
## let cfg = new_config("Project", 1)
## say format_description(cfg)
## ```
pub function format_description(cfg: WebviewConfig) -> string
    return cfg.describe()
end

## Clamps an integer to the closed interval `[min_val, max_val]`.
##
## ### Parameters
## - `n`: Value to clamp.
## - `min_val`: Lower bound.
## - `max_val`: Upper bound.
##
## ### Returns
## Clamped integer within the specified range.
pub function clamp(n: int, min_val: int, max_val: int) -> int
    return clamp_count(n, min_val, max_val)
end

## Returns singular or plural form based on item count.
##
## ### Parameters
## - `n`: The item count.
## - `singular`: Word form for count == 1.
## - `plural`: Word form for counts != 1.
##
## ### Returns
## The selected string based on `n`.
pub function pluralize(n: int, singular: string, plural: string) -> string
    return when n
        is 1 => singular
        else => plural
    end
end

## Returns an array repeating the given string `count` times.
##
## ### Parameters
## - `label`: String to repeat.
## - `count`: Number of occurrences.
##
## ### Returns
## Array of repeated strings.
pub function repeat_string(label: string, count: int) -> array
    return repeat_label(label, count)
end

