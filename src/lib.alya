## webview Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary entry point for cross-platform system webview bindings
## (WebView2 on Windows, WKWebView on macOS, WebKitGTK on Linux).
## All handles are opaque pointers; async browser work arrives through
## `drain` as `WebviewEvent` records. Every function is null-safe, so
## headless environments degrade to empty results instead of errors.

import "./types.alya"
import "./core/events.alya"
import "./native/browser.alya"
import "./ffi.alya"

## Returns the compiled backend id (`1` Windows, `2` macOS, `3` Linux).
pub function backend_id() -> int
    return native_backend_id()
end

## Returns the compiled backend name (`"windows"`, `"macos"`, `"linux"`).
pub function backend() -> string
    return native_backend_name()
end

## Returns the embeddable engine version (`""` when not probeable).
pub function engine_version() -> string
    return native_browser_engine_version()
end

## Creates an empty browser event queue.
pub function event_queue() -> WebviewEventQueue
    return event_queue_new()
end

## Builds default engine settings (devtools off, JS on, default UA).
pub function settings() -> WebviewSettings
    return default_settings()
end

## Builds engine settings with explicit values.
pub function settings_with(devtools: int = 0, js: int = 1, user_agent: string = "") -> WebviewSettings
    return make_settings(devtools, js, user_agent)
end

## Opens a URL in the user's default browser (opt-in fallback).
## Returns `1` when the launch was attempted.
pub function open_external(url: string) -> int
    return native_browser_open_external(url)
end

## Opens a browser window; null when no display or engine is available.
pub function open(title: string = "Alya", width: int = 800, height: int = 600)
    return native_browser_open(title, width, height)
end

## Returns the configured profile folder (`""` when default).
pub function data_dir() -> string
    return native_browser_data_dir()
end

## Returns the configured extra switches (`""` when none).
pub function extra_args() -> string
    return native_browser_extra_args()
end

## Returns the actual folder backing an open window (`""` when none).
pub function profile_path(win) -> string
    return native_browser_profile_path(win)
end

## Opens a private (incognito) window; no persistent profile is kept.
pub function open_private(title: string = "Alya", width: int = 800, height: int = 600)
    return native_browser_open_private(title, width, height)
end

## Sets the profile data folder for subsequently opened windows.
pub function set_data_dir(path: string) -> int
    return native_browser_set_data_dir(path)
end

## Sets extra Chromium switches for subsequently opened windows.
pub function set_extra_args(args: string) -> int
    return native_browser_set_extra_args(args)
end

## Sets the page zoom factor (`1.0` = 100%).
pub function set_zoom(win, factor: float) -> int
    return native_browser_set_zoom(win, factor)
end

## Returns the current zoom factor (`0.0` when unknown).
pub function get_zoom(win) -> float
    return native_browser_get_zoom(win)
end

## Moves the synthetic cursor over client pixel (`x`, `y`).
pub function mouse_move(win, x: int, y: int) -> int
    return native_browser_mouse_move(win, x, y)
end

## Presses a mouse button (`0` left, `1` right, `2` middle).
pub function mouse_down(win, button: int) -> int
    return native_browser_mouse_down(win, button)
end

## Releases a mouse button (`0` left, `1` right, `2` middle).
pub function mouse_up(win, button: int) -> int
    return native_browser_mouse_up(win, button)
end

## Clicks a mouse button (press + release at the cursor position).
pub function mouse_click(win, button: int = 0) -> int
    return native_browser_mouse_click(win, button)
end

## Scrolls by (`dx`, `dy`) detents at the cursor position.
pub function mouse_wheel(win, dx: int, dy: int) -> int
    return native_browser_mouse_wheel(win, dx, dy)
end

## Presses a key (platform code, see `key_code`).
pub function key_down(win, code: int) -> int
    return native_browser_key_down(win, code)
end

## Releases a key.
pub function key_up(win, code: int) -> int
    return native_browser_key_up(win, code)
end

## Taps a key (press + release).
pub function key_tap(win, code: int) -> int
    return native_browser_key_tap(win, code)
end

## Commits printable text to the page.
pub function key_text(win, text: string) -> int
    return native_browser_key_text(win, text)
end

## Maps a key name to the platform code (`-1` when unknown).
pub function key_code(name: string) -> int
    return native_browser_key_code(name)
end

## Sets the page base color (`0..255` per channel).
pub function set_background(win, r: int, g: int, b: int, a: int = 255) -> int
    return native_browser_set_background(win, r, g, b, a)
end

## Toggles the native context menu (`1` shows, `0` suppresses).
pub function set_context_menu(win, enabled: int) -> int
    return native_browser_set_context_menu(win, enabled)
end

## Toggles in-page shortcut blocking (Ctrl+P, PrintScreen, F12, ...).
pub function set_shortcut_block(win, enabled: int) -> int
    return native_browser_set_shortcut_block(win, enabled)
end

## Toggles image loading.
pub function set_images(win, enabled: int) -> int
    return native_browser_set_images(win, enabled)
end

## Toggles WebGL.
pub function set_webgl(win, enabled: int) -> int
    return native_browser_set_webgl(win, enabled)
end

## Sets the default text encoding (`"UTF-8"`).
pub function set_charset(win, cs: string) -> int
    return native_browser_set_charset(win, cs)
end

## Destroys a browser window handle (null-safe).
pub function destroy(win) -> int
    return native_browser_close_handle(win)
end

## Shows a browser window (null-safe).
pub function show(win) -> int
    return native_browser_show(win)
end

## Hides a browser window (null-safe).
pub function hide(win) -> int
    return native_browser_hide(win)
end

## Returns 1 while the window handle is open.
pub function is_open(win) -> int
    return native_browser_is_open(win)
end

## Returns 1 when the rendering engine is attached.
pub function is_ready(win) -> int
    return native_browser_is_ready(win)
end

## Requests a graceful close (null-safe).
pub function request_close(win) -> int
    return native_browser_request_close(win)
end

## Sets the window title (null-safe).
pub function set_title(win, title: string) -> int
    return native_browser_set_title(win, title)
end

## Resizes the window client area (null-safe).
pub function resize(win, width: int, height: int) -> int
    return native_browser_resize(win, width, height)
end

## Navigates to a URL; returns `1` when accepted.
pub function navigate(win, url: string) -> int
    return native_browser_navigate(win, url)
end

## Loads an HTML document string; returns `1` when accepted.
pub function load_html(win, html: string) -> int
    return native_browser_load_html(win, html)
end

## Reloads the current page; returns `1` when accepted.
pub function reload(win) -> int
    return native_browser_reload(win)
end

## Goes back in history; returns `1` when accepted.
pub function back(win) -> int
    return native_browser_back(win)
end

## Goes forward in history; returns `1` when accepted.
pub function forward(win) -> int
    return native_browser_forward(win)
end

## Returns 1 when back navigation is possible.
pub function can_back(win) -> int
    return native_browser_can_back(win)
end

## Returns 1 when forward navigation is possible.
pub function can_forward(win) -> int
    return native_browser_can_forward(win)
end

## Runs JS asynchronously; poll the result with `eval_state`/`eval_result`.
## Returns `1` when the script was submitted.
pub function eval(win, js: string) -> int
    return native_browser_eval(win, js)
end

## Returns the pending eval state (`0` pending, `1` ready, `2` error).
pub function eval_state(win) -> int
    return native_browser_eval_state(win)
end

## Returns the last JS eval result (`""` when none).
pub function eval_result(win) -> string
    return native_browser_eval_result(win)
end

## Submits JS and waits up to `budget` pumps; `""` on error/timeout.
pub function eval_wait(win, js: string, budget: int = 200) -> string
    return native_browser_eval_wait(win, js, budget)
end

## Delivers a string to the page through `window.postMessage`.
## Returns `1` when delivered.
pub function post_message(win, json: string) -> int
    return native_browser_post_message(win, json)
end

## Toggles developer tools; returns `1` when applied.
pub function set_devtools(win, enabled: int) -> int
    return native_browser_set_devtools(win, enabled)
end

## Toggles JavaScript; returns `1` when applied.
pub function set_js(win, enabled: int) -> int
    return native_browser_set_js(win, enabled)
end

## Overrides the user-agent string; returns `1` when applied.
pub function set_user_agent(win, ua: string) -> int
    return native_browser_set_user_agent(win, ua)
end

## Applies a `WebviewSettings` record; returns applied count.
pub function apply_settings(win, s: WebviewSettings) -> int
    return native_browser_apply_settings(win, s)
end

## Pumps once; returns the event kind (`0` = none).
pub function poll(win) -> int
    return native_browser_poll(win)
end

## Drains pending events into `q` as `WebviewEvent` records.
pub function drain(win, q: WebviewEventQueue) -> int
    return native_browser_drain(win, q)
end

## Last event: current URL (`""` when unknown).
pub function last_url(win) -> string
    return native_browser_last_url(win)
end

## Last event: document title (`""` when unknown).
pub function last_title(win) -> string
    return native_browser_last_title(win)
end

## Last `Message` event: payload text (`""` when none).
pub function last_text(win) -> string
    return native_browser_last_text(win)
end

## Native C FFI helper (bundled engine smoke test).
pub function c_add(a: int = 0, b: int = 0) -> int
    return alya_webview_add(a, b)
end
