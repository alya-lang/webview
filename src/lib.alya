@cfg(feature = "storage_media")
pub function scroll_to(win, x: int, y: int) -> int
    return native_browser_scroll_to(win, x, y)
end

## Scrolls by (`dx`, `dy`) pixels.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function scroll_by(win, dx: int, dy: int) -> int
    return native_browser_scroll_by(win, dx, dy)
end

## Scrolls to the top.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function scroll_top(win) -> int
    return native_browser_scroll_top(win)
end

## Scrolls to the bottom.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function scroll_bottom(win) -> int
    return native_browser_scroll_bottom(win)
end

## Opens the print dialog.
## Requires the `inspection` feature (default-on).
@cfg(feature = "inspection")
pub function print_page(win) -> int
    return native_browser_print_page(win)
end

## Mutes (`1`) or unmutes (`0`) all page media elements.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function set_muted(win, muted: int) -> int
    return native_browser_set_muted(win, muted)
end

## Returns `1` when no audible media is playing.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function is_muted(win) -> int
    return native_browser_is_muted(win)
end

## Sets all page media volumes (`0..100`).
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function set_volume(win, level: int) -> int
    return native_browser_set_volume(win, level)
end

## Installs page error forwarding (see `fetch_message` + `is_js_error`).
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function on_error(win) -> int
    return native_browser_on_error(win)
end

## Captures page console output (`1`) or restores it (`0`).
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function capture_console(win, enabled: int) -> int
    return native_browser_capture_console(win, enabled)
end

## Pops the oldest inbox message (`""` when empty).
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function fetch_message(win) -> string
    return native_browser_fetch_message(win)
end

## Returns `1` when a message payload is a forwarded JS error.
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function is_js_error(text: string) -> int
    return native_browser_is_js_error(text)
end

## Returns `1` when a message payload is a captured console entry.
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function is_console(text: string) -> int
    return native_browser_is_console(text)
end

## Destroys a browser window handle (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function destroy(win) -> int
    return native_browser_close_handle(win)
end

## Shows a browser window (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function show(win) -> int
    return native_browser_show(win)
end

## Hides a browser window (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function hide(win) -> int
    return native_browser_hide(win)
end

## Returns 1 while the window handle is open.
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function is_open(win) -> int
    return native_browser_is_open(win)
end

## Returns 1 when the rendering engine is attached.
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function is_ready(win) -> int
    return native_browser_is_ready(win)
end

## Requests a graceful close (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function request_close(win) -> int
    return native_browser_request_close(win)
end

## Sets the window title (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function set_title(win, title: string) -> int
    return native_browser_set_title(win, title)
end

## Resizes the window client area (null-safe).
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function resize(win, width: int, height: int) -> int
    return native_browser_resize(win, width, height)
end

## Navigates to a URL; returns `1` when accepted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function navigate(win, url: string) -> int
    return native_browser_navigate(win, url)
end

## Loads an HTML document string; returns `1` when accepted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function load_html(win, html: string) -> int
    return native_browser_load_html(win, html)
end

## Reloads the current page; returns `1` when accepted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function reload(win) -> int
    return native_browser_reload(win)
end

## Goes back in history; returns `1` when accepted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function back(win) -> int
    return native_browser_back(win)
end

## Goes forward in history; returns `1` when accepted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function forward(win) -> int
    return native_browser_forward(win)
end

## Returns 1 when back navigation is possible.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function can_back(win) -> int
    return native_browser_can_back(win)
end

## Returns 1 when forward navigation is possible.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function can_forward(win) -> int
    return native_browser_can_forward(win)
end

## Runs JS asynchronously; poll the result with `eval_state`/`eval_result`.
## Returns `1` when the script was submitted.
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function eval(win, js: string) -> int
    return native_browser_eval(win, js)
end

## Returns the pending eval state (`0` pending, `1` ready, `2` error).
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function eval_state(win) -> int
    return native_browser_eval_state(win)
end

## Returns the last JS eval result (`""` when none).
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function eval_result(win) -> string
    return native_browser_eval_result(win)
end

## Submits JS and waits up to `budget` pumps; `""` on error/timeout.
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function eval_wait(win, js: string, budget: int = 200) -> string
    return native_browser_eval_wait(win, js, budget)
end

## Delivers a string to the page through `window.postMessage`.
## Returns `1` when delivered.
## Requires the `scripting` feature (default-on).
@cfg(feature = "scripting")
pub function post_message(win, json: string) -> int
    return native_browser_post_message(win, json)
end

## Toggles developer tools; returns `1` when applied.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_devtools(win, enabled: int) -> int
    return native_browser_set_devtools(win, enabled)
end

## Toggles JavaScript; returns `1` when applied.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_js(win, enabled: int) -> int
    return native_browser_set_js(win, enabled)
end

## Overrides the user-agent string; returns `1` when applied.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_user_agent(win, ua: string) -> int
    return native_browser_set_user_agent(win, ua)
end

## Applies a `WebviewSettings` record; returns applied count.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function apply_settings(win, s: WebviewSettings) -> int
    return native_browser_apply_settings(win, s)
end

## Pumps once; returns the event kind (`0` = none).
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function poll(win) -> int
    return native_browser_poll(win)
end

## Drains pending events into `q` as `WebviewEvent` records.
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function drain(win, q: WebviewEventQueue) -> int
    return native_browser_drain(win, q)
end

## Last event: current URL (`""` when unknown).
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function last_url(win) -> string
    return native_browser_last_url(win)
end

## Last event: document title (`""` when unknown).
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function last_title(win) -> string
    return native_browser_last_title(win)
end

## Last `Message` event: payload text (`""` when none).
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function last_text(win) -> string
    return native_browser_last_text(win)
end

## Native C FFI helper (bundled engine smoke test).
pub function c_add(a: int = 0, b: int = 0) -> int
    return alya_webview_add(a, b)
end
