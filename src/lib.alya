## webview Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary entry point for cross-platform system webview bindings
## (WebView2 on Windows, WKWebView on macOS, WebKitGTK on Linux).
## All handles are opaque pointers; async browser work arrives through
## `drain` as `WebviewEvent` records. Every function is null-safe, so
## headless environments degrade to empty results instead of errors.

import "./types.alya"
import "./core/events.alya"
import "./native/browser.alya"
import "./ffi.alya"

## Returns the compiled backend id (`1` Windows, `2` macOS, `3` Linux).
pub function backend_id() -> int
    return native_backend_id()
end

## Returns the compiled backend name (`"windows"`, `"macos"`, `"linux"`).
pub function backend() -> string
    return native_backend_name()
end

## Returns the embeddable engine version (`""` when not probeable).
pub function engine_version() -> string
    return native_browser_engine_version()
end

## Creates an empty browser event queue.
## Requires the `events` feature (default-on).
@cfg(feature = "events")
pub function event_queue() -> WebviewEventQueue
    return event_queue_new()
end

## Builds default engine settings (devtools off, JS on, default UA).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function settings() -> WebviewSettings
    return default_settings()
end

## Builds engine settings with explicit values.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function settings_with(devtools: int = 0, js: int = 1, user_agent: string = "") -> WebviewSettings
    return make_settings(devtools, js, user_agent)
end

## Opens a URL in the user's default browser (opt-in fallback).
## Returns `1` when the launch was attempted.
## Requires the `navigation` feature (default-on).
@cfg(feature = "navigation")
pub function open_external(url: string) -> int
    return native_browser_open_external(url)
end

## Opens a browser window; null when no display or engine is available.
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function open(title: string = "Alya", width: int = 800, height: int = 600)
    return native_browser_open(title, width, height)
end

## Returns the configured profile folder (`""` when default).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function data_dir() -> string
    return native_browser_data_dir()
end

## Returns the configured extra switches (`""` when none).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function extra_args() -> string
    return native_browser_extra_args()
end

## Returns the actual folder backing an open window (`""` when none).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function profile_path(win) -> string
    return native_browser_profile_path(win)
end

## Opens a private (incognito) window; no persistent profile is kept.
## Requires the `window` feature (default-on).
@cfg(feature = "window")
pub function open_private(title: string = "Alya", width: int = 800, height: int = 600)
    return native_browser_open_private(title, width, height)
end

## Sets the profile data folder for subsequently opened windows.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_data_dir(path: string) -> int
    return native_browser_set_data_dir(path)
end

## Sets extra Chromium switches for subsequently opened windows.
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_extra_args(args: string) -> int
    return native_browser_set_extra_args(args)
end

## Sets the page zoom factor (`1.0` = 100%).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function set_zoom(win, factor: float) -> int
    return native_browser_set_zoom(win, factor)
end

## Returns the current zoom factor (`0.0` when unknown).
## Requires the `settings` feature (default-on).
@cfg(feature = "settings")
pub function get_zoom(win) -> float
    return native_browser_get_zoom(win)
end

## Moves the synthetic cursor over client pixel (`x`, `y`).
## Requires the `input` feature (default-on).
@cfg(feature = "input")
pub function mouse_move(win, x: int, y: int) -> int
    return native_browser_mouse_move(win, x, y)
end

