## Reads a localStorage value (JSON-encoded).
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function storage_get(win, key: string) -> string
    return native_browser_storage_get(win, key)
end

## Writes a localStorage value.
## Requires the `storage_media` feature (default-on).
@cfg(feature = "storage_media")
pub function storage_set(win, key: string, value: string) -> int
