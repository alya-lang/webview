## webview Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Browser-domain models: event kinds, event records, settings, and the
## portable event queue consumed by `native/browser.alya` and `lib.alya`.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Browser event kinds, mirroring `ALYA_WEBVIEW_EVENT_*` in `c/webview.h`.
##
## `None` is never queued; `poll()` returns it when no event is pending.
pub enum WebviewEventKind
    None = 0,
    Close = 1,
    Resize = 2,
    NavStart = 3,
    NavDone = 4,
    Title = 5,
    Message = 6,
    NavFailed = 7
end

## JS eval completion states, mirroring `ALYA_WEBVIEW_EVAL_*`.
pub enum WebviewEvalState
    Pending = 0,
    Ready = 1,
    Error = 2
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## One drained browser event.
##
## ### Fields
## - `kind`: Event kind (`WebviewEventKind` value).
## - `width`: Client width in pixels at event time.
## - `height`: Client height in pixels at event time.
## - `url`: Current URL (`""` when unknown).
## - `title`: Current document title (`""` when unknown).
## - `text`: Message payload (`Message` events only, else `""`).
pub struct WebviewEvent
    kind: int,
    width: int,
    height: int,
    url: string,
    title: string,
    text: string
end

## Engine settings applied with `apply_settings`.
##
## ### Fields
## - `devtools`: `1` enables developer tools, `0` disables them.
## - `js`: `1` enables JavaScript, `0` disables it.
## - `user_agent`: Custom user-agent string (`""` leaves the default).
pub struct WebviewSettings
    devtools: int,
    js: int,
    user_agent: string
end

# ───────────────────────────────────────────────────────────────
# Factory Constructors
# ───────────────────────────────────────────────────────────────

## Builds default engine settings (devtools off, JS on, default UA).
##
## ### Examples
## ```alya
## let s = default_settings()
## ```
pub function default_settings() -> WebviewSettings
    return WebviewSettings {
        devtools: 0,
        js: 1,
        user_agent: ""
    }
end

## Builds engine settings with explicit values.
##
## ### Parameters
## - `devtools`: `1` enables developer tools. Defaults to `0`.
## - `js`: `1` enables JavaScript. Defaults to `1`.
## - `user_agent`: Custom user-agent string. Defaults to `""`.
pub function make_settings(devtools: int = 0, js: int = 1, user_agent: string = "") -> WebviewSettings
    return WebviewSettings {
        devtools: devtools,
        js: js,
        user_agent: user_agent
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: WebviewEvent
# ───────────────────────────────────────────────────────────────

## Returns 1 when this event closes the window (`Close` kind).
pub function WebviewEvent.is_close(self: WebviewEvent) -> int
    if self.kind == WebviewEventKind.Close
        return true
    end
    return false
end

## Returns 1 when this event carries a JS message (`Message` kind).
pub function WebviewEvent.is_message(self: WebviewEvent) -> int
    if self.kind == WebviewEventKind.Message
        return true
    end
    return false
end

## Returns a one-line summary of this event for logging.
pub function WebviewEvent.summary(self: WebviewEvent) -> string
    return "event(kind={self.kind}, url={self.url})"
end
